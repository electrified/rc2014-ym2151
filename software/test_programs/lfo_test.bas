10 REM YM2151 LFO TEST - SIMPLE SINE
20 REM ALG 0: M1->C1->M2->C2
30 REM M1/C1/M2 SILENT, C2=SINE+AME
40 YA=&HFE : YD=&HFF : REM PORT ADDRESSES
50 NC=&H3A : REM MIDDLE C
60 REM
70 REM YM2151 REGISTER ADDRESSES
80 KO=&H08 : REM KEY ON/OFF
90 LF=&H18 : REM LFO FREQUENCY
100 AD=&H19 : REM AMD/PMD DEPTH
110 LW=&H1B : REM LFO WAVEFORM
120 CC=&H20 : REM CHANNEL CONTROL (RL/FB/CON)
130 KC=&H28 : REM KEY CODE
140 SM=&H38 : REM SENSITIVITY (AMS/PMS)
150 REM
160 GOTO 310
170 REM
180 REM WRITE A (ADDR) D (DATA) TO YM2151
190 OUT YA,A : OUT YD,D
200 RETURN
210 REM
220 REM KEY ON/OFF: KEYOFF, KEYON, WAIT, KEYOFF
230 A=KO : D=0 : GOSUB 190
240 A=KO : D=&H78 : GOSUB 190
250 FOR I=1 TO 1500 : NEXT
260 A=KO : D=0 : GOSUB 190
270 RETURN
280 REM
290 REM === MAIN PROGRAM ===
300 REM
310 REM LFO RESET: ENSURE LFO IS RUNNING
320 A=1 : D=2 : GOSUB 190
330 A=1 : D=0 : GOSUB 190
340 REM
350 REM LOAD PATCH: ALG 0, FB=0
360 REM C2=SINE+AME, M1/C1/M2 SILENT
370 FOR I=1 TO 25
380 READ A, D
390 GOSUB 190
400 NEXT I
410 REM
800 REM LFO FREQUENCY: ~3.4 HZ
810 A=LF : D=&HC0 : GOSUB 190
820 REM LFO WAVEFORM: SAW (0=Saw,1=Sqr,2=Tri,3=Noise)
830 A=LW : D=0 : GOSUB 190
840 REM KEY CODE: MIDDLE C
850 A=KC : D=NC : GOSUB 190
860 REM
920 REM === INTERACTIVE LOOP ===
930 PRINT "--- YM2151 AM TEST ---"
940 PRINT "ALG 0: ONLY C2 ACTIVE"
950 PRINT
970 PRINT "AMS: AM SENSITIVITY (0-3)"
980 INPUT A1
990 PRINT "PMS: PM SENSITIVITY (0-7)"
1000 INPUT P1
1010 PRINT "AMD: AM DEPTH (0-127)"
1020 INPUT M1
1030 PRINT "PMD: PM DEPTH (0-127)"
1040 INPUT M2
1050 REM
1060 REM SET AMD (MSB=0)
1070 A=AD : D=M1 : GOSUB 190
1080 REM SET PMD (MSB=1)
1090 A=AD : D=&H80 OR M2 : GOSUB 190
1100 REM
1110 REM SET AMS/PMS: PMS IN BITS 6:4, AMS IN BITS 1:0
1120 A=SM : D=(P1 AND 7)*16 OR (A1 AND 3) : GOSUB 190
1130 REM
1140 REM PLAY NOTE
1150 GOSUB 230
1160 REM
1170 REM LOOP
1180 GOTO 930
1190 REM
1200 REM --- PATCH DATA: ALG 0, RL=3, FB=0 ---
1210 REM CHANNEL CONTROL
1220 DATA &H20, &HC0
1230 REM M1: SILENT (TL=7F)
1240 DATA &H40, 0
1250 DATA &H60, &H7F
1260 DATA &H80, &H1F
1270 DATA &HA0, 0
1280 DATA &HC0, 0
1290 DATA &HE0, &H0F
1300 REM C1: SILENT (TL=7F)
1310 DATA &H48, 0
1320 DATA &H68, &H7F
1330 DATA &H88, &H1F
1340 DATA &HA8, 0
1350 DATA &HC8, 0
1360 DATA &HE8, &H0F
1370 REM M2: SILENT (TL=7F)
1380 DATA &H50, 0
1390 DATA &H70, &H7F
1400 DATA &H90, &H1F
1410 DATA &HB0, 0
1420 DATA &HD0, 0
1430 DATA &HF0, &H0F
1440 REM C2: FULL VOLUME SINE + AME
1450 DATA &H58, 0
1460 DATA &H78, 0
1470 DATA &H98, &H1F
1480 DATA &HB8, &H80
1490 DATA &HD8, 0
1500 DATA &HF8, &H0F
